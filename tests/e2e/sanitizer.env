# Sanitizer runtime options, read by tests/e2e/sanitizer.cmake and ffi.nimble.
ASAN_OPTIONS=halt_on_error=1:abort_on_error=1:detect_leaks=1:strict_string_checks=1
UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
LSAN_OPTIONS=suppressions=@REPO_ROOT@/lsan.supp:print_suppressions=0
TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1:history_size=7:suppressions=@REPO_ROOT@/tsan.supp
